# Production environment variables (example) - DO NOT COMMIT real secrets
# Use this file as a checklist for values to set on Render (or other hosts).
SECRET_KEY=
DEBUG=False
DATABASE_URL=
ALLOWED_HOSTS=sewcut-backend.onrender.com,your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email / SMTP (if used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Any other secrets your app requires (Sentry, third-party keys)
# SENTRY_DSN=

# Instructions:
# 1) Generate a SECRET_KEY locally:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2) Open your Render Service → Environment → Add a new env var named SECRET_KEY and paste the generated value.
# 3) Fill DATABASE_URL with the Render Postgres database URL (created in Render Databases).
# 4) Set other values (EMAIL credentials, CORS origins, etc.).
# 5) Redeploy the service.
