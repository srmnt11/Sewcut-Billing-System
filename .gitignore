# Ignore backend virtual environment
sewcut-backend/venv/

# Ignore backend environment files with secrets
sewcut-backend/.env
sewcut-backend/.env.*
!sewcut-backend/.env.example
!sewcut-backend/.env.production.example
sewcut-backend/staticfiles/

# Ignore Python cache and compiled files
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Byte-compiled / optimized / DLL files
__pycache__/
*.so
*.egg
*.egg-info/

